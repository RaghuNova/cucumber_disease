# CucumberCare AI - Backend Environment Configuration

# [OPTIONAL] Google Gemini API Key for agronomic explanations.
# If omitted, the system falls back to Groq, or to the built-in static botanical pathology knowledge base.
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Groq API Key as secondary LLM fallback.
GROQ_API_KEY=your_groq_api_key_here

# Server binding configuration
PORT=8000
HOST=0.0.0.0
